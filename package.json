{
  "dependencies": {
    "@tanstack/react-query": "5.100.10",
    "jszip": "^3.10.2",
    "qrcode": "1.5.4",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "description": "Standalone Jimeng Video Downloader — public Jimeng/Dreamina share link to original no-watermark MP4. Runs on Bun + SQLite, no external services.",
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "bun-plugin-tailwind": "0.0.15",
    "tailwindcss": "4.1.13",
    "tailwindcss-safe-area": "1.3.0",
    "typescript": "5.6.3"
  },
  "name": "jimeng-video-downloader-standalone",
  "packageManager": "bun@1.3.10",
  "private": true,
  "scripts": {
    "build": "bun run build:client",
    "build:client": "bun ./client/build.mjs",
    "dev": "bun run server/server.ts",
    "start": "bun run server/server.ts",
    "typecheck": "bun x tsc --noEmit -p client/tsconfig.json && bun x tsc --noEmit -p server/tsconfig.json"
  },
  "type": "module",
  "version": "1.0.0"
}