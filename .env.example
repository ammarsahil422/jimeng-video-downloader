# Copy to .env when you want to change a default. All of these are optional.
# The server reads them from the environment (or from systemd's Environment= lines).

# Port the site listens on (default 3000). With nginx in front, keep 3000.
PORT=3000

# Interface to listen on. 0.0.0.0 = reachable from outside the server.
HOST=0.0.0.0

# Where the SQLite database (app.db) and downloaded video files live.
# Default: ./data next to this package. Use an absolute path if you run the
# server from another directory (e.g. /var/lib/jimeng-downloader/data).
DATA_DIR=./data

# Max total size of cached downloaded videos (bytes). Default 5 GB.
# When the cache passes this, the oldest files are deleted first.
MAX_CACHE_BYTES=5000000000
